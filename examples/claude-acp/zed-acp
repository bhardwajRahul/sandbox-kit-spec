#!/usr/bin/env bash
# Bridges Zed's ACP client to a sandboxed Claude Code session.
#
# Zed spawns this on the host with the project root as cwd and speaks ACP
# over the process's stdio. The script ensures one sandbox per project,
# composed of the three kits the ACP path needs, and then hands that
# stdio to the adapter inside it. stdout is the ACP wire: diagnostics go
# to stderr, which Zed shows in its agent-server log.
set -euo pipefail

: "${SBX_ACP_BASE:=docker.io/cdupuis/sbx-kit-shell:1.0.1}"
: "${SBX_ACP_CLAUDE:=docker.io/cdupuis/sbx-kit-claude-mixin:1.0.0}"
: "${SBX_ACP_ADAPTER:=docker.io/cdupuis/sbx-kit-claude-acp:1.0.1}"

project="${1:-$PWD}"
cd "$project"
project="$PWD"
name="acp-$(basename "$project")-$(printf '%s' "$project" | shasum -a 256 | cut -c1-8)"

if ! sbx ls -q 2>/dev/null | grep -qx "$name"; then
	echo "sbx: creating $name for $project" >&2
	sbx run "$SBX_ACP_BASE" \
		--kit "$SBX_ACP_CLAUDE" \
		--kit "$SBX_ACP_ADAPTER" \
		--name "$name" \
		--detached \
		"$project" >&2
fi

# The workspace binds at its host path inside the sandbox, so the paths
# Zed sends over ACP — session/new's cwd, and file locations in both
# directions — are valid on both sides with no translation.
#
# -i without -t: an ACP server needs a pipe, and a PTY would corrupt the
# JSON-RPC framing with echo and line editing.
#
# CLAUDE_CODE_EXECUTABLE is also image config in the adapter kit; passing
# it here keeps the binding correct even when the sandbox was assembled
# by a frontend that predates additive config merging.
exec sbx exec -i \
	-w "$project" \
	-e CLAUDE_CODE_EXECUTABLE=/usr/local/bin/claude \
	"$name" claude-agent-acp
