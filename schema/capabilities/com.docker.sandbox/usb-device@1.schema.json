{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "com.docker.sandbox/usb-device@1",
  "description": "Config schema for one usb-device need: passthrough matched by vendorId/productId together or by class \u2014 exactly one of the two shapes. Instance-shaped. The @1 in the type names this schema; it moves when the schema does.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "vendorId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "class": {
      "type": "string"
    }
  },
  "oneOf": [
    {
      "required": [
        "vendorId",
        "productId"
      ],
      "not": {
        "required": [
          "class"
        ]
      }
    },
    {
      "required": [
        "class"
      ],
      "allOf": [
        {
          "not": {
            "required": [
              "vendorId"
            ]
          }
        },
        {
          "not": {
            "required": [
              "productId"
            ]
          }
        }
      ]
    }
  ]
}