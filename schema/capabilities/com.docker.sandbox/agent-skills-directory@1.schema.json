{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "com.docker.sandbox/agent-skills-directory@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path"
  ],
  "properties": {
    "path": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^(/([^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+))+$"
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
        }
      ],
      "description": "Absolute, canonical agent discovery directory for bundled skills. Grants no host store access."
    }
  }
}
