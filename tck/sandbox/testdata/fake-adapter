#!/usr/bin/env bash
# A runtime that exists only to test the suite. It implements the
# conformance contract over a state directory, and KIT_TCK_FAKE_BROKEN
# makes it violate one requirement at a time, so each check can be shown to
# fail when the behavior it judges is absent.
set -euo pipefail

state="${KIT_TCK_FAKE_STATE:?KIT_TCK_FAKE_STATE is required}"
broken="${KIT_TCK_FAKE_BROKEN:-}"

# What this runtime claims: everything it implements, a subset when the
# suite narrows it, nothing when broken that way. The refusal duty below
# is always keyed off this same list, because claiming and refusing are
# two sides of one statement.
default_claims="com.docker.sandbox/long-running@1,com.docker.sandbox/sbx@1,com.docker.sandbox/lifecycle@1,com.docker.sandbox/network-policy@1,com.docker.sandbox/network-policy@2,com.docker.sandbox/credential@1,com.docker.sandbox/agent-context@1,com.docker.sandbox/volume@1,com.docker.sandbox/resources@1,com.docker.sandbox/privileged@1,com.docker.sandbox/agent-skills@1,com.docker.sandbox/ssh-agent@1"
claims="${KIT_TCK_FAKE_CLAIMS:-$default_claims}"
if [ "$broken" = "claims-nothing" ]; then claims=""; fi
verb="${1:-}"
shift || true

# The group fixture's observable files, ordering, records and grant surface.
write_group_state() {
  local dir="$1" rejected="$2"
  local -a records=()
  local skipped='' surface='{}' IFS=,
  if [ "$broken" != group-missing-ordinary-record ]; then
    records+=('{"path":"capabilities[0]","source":{"kit":"groups","path":"capabilities[0]"},"members":["capabilities[0]"]}')
  fi
  echo "$rejected" >"$dir/group-rejected"
  if [ "$rejected" = yes ]; then
    printf 'base,independent' >"$dir/group-order"
    rm -f "$dir/group-feature"
    if [ "$broken" = group-file-leak ]; then echo selected >"$dir/group-feature"; fi
    skipped='{"path":"capabilities[1]","name":"Feature","source":{"kit":"groups","path":"capabilities[1]"},"members":["capabilities[1].group.capabilities[0]","capabilities[1].group.capabilities[1]"],"rejected":["capabilities[1].group.capabilities[0]"]}'
  else
    printf 'base,feature,independent' >"$dir/group-order"
    echo selected >"$dir/group-feature"
    records+=('{"path":"capabilities[1]","name":"Feature","source":{"kit":"groups","path":"capabilities[1]"},"members":["capabilities[1].group.capabilities[0]","capabilities[1].group.capabilities[1]"]}')
    surface='{"storagePaths":["/var/tmp/group-volume"]}'
  fi
  if [ "$broken" != group-missing-independent-record ]; then
    records+=('{"path":"capabilities[2]","name":"Feature","source":{"kit":"groups","path":"capabilities[2]"},"members":["capabilities[2].group.capabilities[0]"]}')
  fi
  if [ "$broken" = group-extra-grant ]; then
    surface='{"services":["group:Feature"]}'
    if [ "$rejected" != yes ]; then surface='{"services":["group:Feature"],"storagePaths":["/var/tmp/group-volume"]}'; fi
  fi
  printf '{"selection":{"selected":[%s],"skipped":[%s]},"surface":%s}\n' "${records[*]}" "$skipped" "$surface" >"$dir/selection.json"
  case "$broken" in
  group-wrong-source-path)
    sed 's/"source":{"kit":"groups","path":"capabilities\[1\]"}/"source":{"kit":"groups","path":"capabilities[9]"}/' "$dir/selection.json" >"$dir/selection.tmp"
    mv "$dir/selection.tmp" "$dir/selection.json"
    ;;
  group-wrong-source-kit)
    sed 's/"kit":"groups"/"kit":"other-kit"/g' "$dir/selection.json" >"$dir/selection.tmp"
    mv "$dir/selection.tmp" "$dir/selection.json"
    ;;
  group-accepted-rejection)
    if [ "$rejected" = no ]; then
      sed 's/"name":"Feature"/"rejected":["capabilities[1].group.capabilities[1]"],"name":"Feature"/' "$dir/selection.json" >"$dir/selection.tmp"
      mv "$dir/selection.tmp" "$dir/selection.json"
    fi
    ;;
  group-extra-rejection)
    if [ "$rejected" = yes ]; then
      sed 's/"rejected":\["capabilities\[1\].group.capabilities\[0\]"\]/"rejected":["capabilities[1].group.capabilities[0]","capabilities[1].group.capabilities[1]"]/' "$dir/selection.json" >"$dir/selection.tmp"
      mv "$dir/selection.tmp" "$dir/selection.json"
    fi
    ;;
  esac
  if [ "$broken" = group-order ]; then printf 'independent,base' >"$dir/group-order"; fi
  if [ "$broken" = group-records ]; then echo '{"selection":{},"surface":{}}' >"$dir/selection.json"; fi
  if [ "$broken" = group-member-paths ]; then
    sed 's/,"members":\["[^"]*","[^"]*"\]//' "$dir/selection.json" >"$dir/selection.tmp"
    mv "$dir/selection.tmp" "$dir/selection.json"
  fi
}

# Publication shifts consumed paths while retaining the original member sources.
write_republished_state() {
  local dir="$1" rejected="$2"
  local base feature sources selected skipped='' surface='{}'
  base='{"path":"capabilities[0]","source":{"kit":"registry.example/base:1.0.0","path":"capabilities[0]"},"members":["capabilities[0].group.capabilities[0]"],"memberSources":[{"kit":"registry.example/base:1.0.0","path":"capabilities[0]"}]}'
  sources=',"memberSources":[{"kit":"registry.example/feature:1.0.0","path":"capabilities[0].group.capabilities[0]"},{"kit":"registry.example/feature:1.0.0","path":"capabilities[0].group.capabilities[1]"}]'
  if [ "$broken" = group-selected-member-sources ] && [ "$rejected" = no ]; then sources=''; fi
  if [ "$broken" = group-skipped-member-sources ] && [ "$rejected" = yes ]; then sources=''; fi
  if [ "$broken" = group-member-sources-local ]; then
    sources=',"memberSources":[{"kit":"groups-republished","path":"capabilities[1].group.capabilities[0]"},{"kit":"groups-republished","path":"capabilities[1].group.capabilities[1]"}]'
  fi
  feature='{"path":"capabilities[1]","source":{"kit":"registry.example/feature:1.0.0","path":"capabilities[0]"},"members":["capabilities[1].group.capabilities[0]","capabilities[1].group.capabilities[1]"]'
  feature="$feature$sources"
  selected="$base"
  if [ "$rejected" = yes ]; then
    skipped="$feature,"'"rejected":["capabilities[1].group.capabilities[0]"]}'
  else
    selected="$base,$feature}"
    surface='{"storagePaths":["/var/tmp/republished-volume"]}'
  fi
  printf '{"selection":{"selected":[%s],"skipped":[%s]},"surface":%s}\n' "$selected" "$skipped" "$surface" >"$dir/selection.json"
}

run_ssh_probe() (
  local dir="$1" backing="$2" relay_broken="$3" relay_dir relay_pid status
  shift 3
  : "${KIT_TCK_FAKE_RELAY:?KIT_TCK_FAKE_RELAY names the built ssh-relay}"
  # A Unix socket path is capped near 104 bytes on macOS, which the
  # state directory can exceed.
  relay_dir="$(mktemp -d /tmp/kit-tck-relay-XXXXXX)"
  "$KIT_TCK_FAKE_RELAY" -listen "$relay_dir/agent.sock" -backing "$backing" \
    -config "$dir/ssh-agent.json" -known-hosts "$dir/known_hosts" -broken "$relay_broken" 2>/dev/null &
  relay_pid=$!
  trap 'kill "$relay_pid" 2>/dev/null || true; wait "$relay_pid" 2>/dev/null || true; rm -rf "$relay_dir"' EXIT
  for _ in $(seq 1 100); do [ -S "$relay_dir/agent.sock" ] && break; sleep 0.02; done
  status=0
  SSH_AUTH_SOCK="$relay_dir/agent.sock" python3 "$(cat "$dir/ssh-agent-probe")" "$@" || status=$?
  exit "$status"
)

record_ssh_processes() {
  local dir="$1" boot="$2" process process_agent process_socket process_broken
  for process in workload startup; do
    process_agent="$(cat "$dir/ssh-agent")"
    process_socket=/run/kit-tck/ssh-agent.sock
    if [ "$broken" = "ssh-agent-missing-$process-env" ] || { [ "$boot" = restart ] && [ "$broken" = "ssh-agent-restart-missing-$process-env" ]; }; then
      process_agent=""
      process_socket=""
    elif [ "$broken" = "ssh-agent-bogus-$process-socket" ]; then
      process_agent="$dir/nonexistent-agent.sock"
      process_socket=/run/kit-tck/nonexistent-agent.sock
    fi
    printf '%s' "$process_socket" >"$dir/$process-ssh-sock"
    process_broken="$broken"
    if [ "$broken" = "ssh-agent-$boot-$process-unfiltered-sign" ]; then process_broken=ssh-agent-unfiltered-sign; fi
    if [ "$broken" = "ssh-agent-$boot-$process-forward-refused-sign" ]; then process_broken=ssh-agent-sign-forwards-refused; fi
    if [ "$broken" = "ssh-agent-$boot-$process-unfiltered-operations" ]; then process_broken=ssh-agent-forwards-constrained-rsa; fi
    if [ -S "$process_agent" ]; then
      run_ssh_probe "$dir" "$process_agent" "$process_broken" observe >"$dir/$process-ssh-sock-proof" 2>&1 || true
    else
      SSH_AUTH_SOCK="$process_agent" python3 "$(cat "$dir/ssh-agent-probe")" observe >"$dir/$process-ssh-sock-proof" 2>&1 || true
    fi
  done
}

case "$verb" in
capabilities)
  if [ -n "$claims" ]; then echo "$claims" | tr ',' '\n'; fi
  ;;

create)
  kits=()
  greeting=""
  group_path=/var/tmp/group-expanded
  hostmode="readwrite"
  # The backing SSH agent available to this sandbox; empty when none is.
  offered_agent=""
  known_hosts=""
  group_rejected=no
  lifecycle_rejected=no
  while [ $# -gt 0 ]; do
    case "$1" in
    --arg)
      case "$2" in greeting=*) greeting="${2#greeting=}" ;; group_path=*) group_path="${2#group_path=}" ;; esac
      shift 2
      ;;
    --reject-capability)
      if [ "$2" = com.docker.sandbox/volume@1 ]; then group_rejected=yes; fi
      if [ "$2" = com.docker.sandbox/lifecycle@1 ]; then lifecycle_rejected=yes; fi
      shift 2
      ;;
    --skills-host-mode)
      hostmode="$2"
      shift 2
      ;;
    --ssh-agent)
      offered_agent="$2"
      shift 2
      ;;
    --ssh-known-hosts)
      known_hosts="$2"
      shift 2
      ;;
    *)
      kits+=("$1")
      shift
      ;;
    esac
  done

  # Required and optional skills entries part ways when the host's store
  # is off: a required one cannot be satisfied and forces a refusal, an
  # optional one is skipped and the sandbox starts without the mount.
  required_skills=""
  optional_skills=""
  for kit in "${kits[@]}"; do
    case "$kit" in
    *skills-optional*) optional_skills=1 ;;
    *skills*) required_skills=1 ;;
    esac
  done
  if [ "$hostmode" = "off" ] && [ -n "$required_skills" ] && [ "$broken" != "ignores-host-off" ]; then
    echo "refusing: the host's skills setting is off and the kit requires the store" >&2
    exit 2
  fi
  if [ "$hostmode" = "off" ] && [ -n "$optional_skills" ] && [ "$broken" = "refuses-optional-skills" ]; then
    echo "refusing: skills are off" >&2
    exit 2
  fi

  # A required capability this runtime does not implement is refused,
  # unless the fake is told to accept it.
  for kit in "${kits[@]}"; do
    if [[ "$kit" == *unknown-required-capability* && "$broken" != "accept-unknown" ]]; then
      echo "refusing: kit requires a capability this runtime does not implement" >&2
      # Exit 2 is the contract's refusal signal: deliberate, not a failure.
      if [ "$broken" = "refusal-as-error" ]; then exit 1; fi
      exit 2
    fi
  done

  # A fixture whose required capability is unclaimed is refused, exactly
  # as the contract expects of a real partial runtime.
  # accepts-required-unclaimed is the runtime that skips this duty and
  # quietly under-provisions.
  if [ "$broken" != "accepts-required-unclaimed" ]; then
    for kit in "${kits[@]}"; do
      need=""
      case "$kit" in
      *long-running-optional*)
        if [ "$broken" = "refuses-optional-long-running" ]; then exit 2; fi
        ;;
      *long-running-workload*) ;;
      *long-running*) need="com.docker.sandbox/long-running@1" ;;
      */ssh-agent-optional) ;;
      */ssh-agent | */ssh-agent-install | */ssh-agent-bounded) need="com.docker.sandbox/ssh-agent@1" ;;
      *skills-optional* | *scoped-egress*) ;;
      # Before the *context* arm, whose name this fixture also carries
      # through its own agent-context profile.
      *sbx-workload*) need="com.docker.sandbox/sbx@1" ;;
      *context*) need="com.docker.sandbox/agent-context@1" ;;
      *hooks* | *files* | *restricted-env*) need="com.docker.sandbox/lifecycle@1" ;;
      # Before the *egress* arm, which would otherwise claim this name.
      *http-egress*) need="com.docker.sandbox/network-policy@2" ;;
      *egress*) need="com.docker.sandbox/network-policy@1" ;;
      *credential*) need="com.docker.sandbox/credential@1" ;;
      *volume*) need="com.docker.sandbox/volume@1" ;;
      *resources*) need="com.docker.sandbox/resources@1" ;;
      *privileged*) need="com.docker.sandbox/privileged@1" ;;
      *skills*) need="com.docker.sandbox/agent-skills@1" ;;
      *port*) need="com.docker.sandbox/port@1" ;;
      *usb-device*) need="com.docker.sandbox/usb-device@1" ;;
      *agent-sessions*) need="com.docker.sandbox/agent-sessions@1" ;;
      *kit-registry*) need="com.docker.sandbox/kit-registry@1" ;;
      esac
      if [ -n "$need" ] && ! printf ',%s,' "$claims" | grep -q ",$need,"; then
        echo "refusing: kit requires $need, which this runtime does not claim" >&2
        exit 2
      fi
    done
  fi

  if [ "$broken" = "refuses-everything" ]; then
    echo "refusing: this runtime declines every composition" >&2
    exit 2
  fi

  # Which phase, if any, asks for the SSH agent, and whether the ask can
  # be dropped. A required ask the host cannot answer is refused before
  # anything starts; an optional one is skipped.
  agent_phase=""
  agent_required=""
  # The entry each fixture declares, as the relay reads it. A real runtime
  # takes this from the descriptor; the fake knows its fixtures by name.
  agent_config='{"phase":"runtime"}'
  for kit in "${kits[@]}"; do
    case "$kit" in
    */ssh-agent-install) agent_phase=install agent_required=1 agent_config='{"phase":"install"}' ;;
    */ssh-agent-optional) agent_phase=runtime ;;
    */ssh-agent-bounded)
      agent_phase=runtime agent_required=1
      agent_config='{"phase":"runtime","unrestricted":false,"sign":["git"],"authenticate":["git@kit-tck.example","any-user.kit-tck.example"]}'
      ;;
    */ssh-agent) agent_phase=runtime agent_required=1 ;;
    esac
  done
  if [ -n "$agent_required" ] && [ -z "$offered_agent" ] && [ "$broken" != "ssh-agent-accepts-without-agent" ]; then
    if [ "$broken" = ssh-agent-refusal-unnamed ]; then echo "refusing: unavailable" >&2; exit 2; fi
    echo "refusing: the kit requires com.docker.sandbox/ssh-agent@1 and no backing agent is available" >&2
    exit 2
  fi
  if [ -n "$agent_phase" ] && [ -z "$offered_agent" ] && [ "$broken" = "ssh-agent-refuses-optional" ]; then
    echo "refusing: no SSH agent" >&2
    exit 2
  fi

  if [ "$broken" = "create-always-errors" ]; then
    echo "simulated failure unrelated to any policy decision" >&2
    exit 1
  fi

  for kit in "${kits[@]}"; do
    case "$kit" in
    */groups-expanded)
      if [ "$group_path" = relative ]; then
        if [ "$broken" != group-invalid-expanded ] && { [ "$lifecycle_rejected" = no ] || [ "$broken" != group-skips-invalid-expanded ]; }; then
          echo "groups-expanded capabilities[0].group.capabilities[0].config.files[0].path: must be absolute" >&2
          exit 2
        fi
      fi
      ;;
    */ordinary-required)
      if [ "$lifecycle_rejected" = yes ] && [ "$broken" != ordinary-ignore-required-rejection ]; then
        echo "ordinary-required capabilities[0]: rejected" >&2
        exit 2
      fi
      ;;
    */groups-required)
      if [[ ",$claims," != *",com.docker.sandbox/volume@1,"* ]] && [ "$broken" != partial-required-skips-volume ]; then
        echo "groups-required capabilities[0].group.capabilities[0]: unclaimed" >&2
        exit 2
      fi
      if [[ ",$claims," != *",com.docker.sandbox/lifecycle@1,"* ]] && [ "$broken" != partial-required-skips-lifecycle ]; then
        echo "groups-required capabilities[0].group.capabilities[1]: unclaimed" >&2
        exit 2
      fi
      if [ "$lifecycle_rejected" = yes ] && [ "$broken" != group-ignore-required-lifecycle ]; then
        echo "groups-required capabilities[0].group.capabilities[1]: rejected" >&2
        exit 2
      fi
      if [ "$group_rejected" = yes ] && [ "$broken" != group-accept-required ]; then
        source_kit=groups-required
        if [ "$broken" = group-required-no-kit ]; then source_kit=''; fi
        echo "$source_kit capabilities[0].group.capabilities[0]: rejected" >&2
        exit 2
      fi
      ;;
    */groups-conflict)
      if [ "$broken" != group-drop-conflict ]; then
        source_kit=groups-conflict
        if [ "$broken" = group-conflict-no-kit ]; then source_kit=''; fi
        echo "$source_kit capabilities[0] and capabilities[1]: duplicate file" >&2
        exit 2
      fi
      ;;
    */groups-interactive-conflict)
      if [ "$broken" != group-drop-interactive-conflict ]; then
        source_kit=groups-interactive-conflict
        if [ "$broken" = group-conflict-no-kit ]; then source_kit=''; fi
        echo "$source_kit capabilities[0] and capabilities[1]: multiple interactive declarations" >&2
        exit 2
      fi
      ;;
    */groups-failure)
      if [ "$broken" != group-skip-failure ]; then
        echo 'groups-failure: selected hook exited 37' >&2
        exit 1
      fi
      ;;
    esac
  done

  id="sbx-$$-${RANDOM}"
  dir="$state/$id"
  mkdir -p "$dir"
  echo running >"$dir/status"
  # The probe the workload fixture ships, which the fake runs itself.
  for kit in "${kits[@]}"; do
    if [[ "$kit" == */workload ]]; then printf '%s' "$kit/kit-tck-ssh-agent.py" >"$dir/ssh-agent-probe"; fi
  done
  printf '%s' "$agent_config" >"$dir/ssh-agent.json"
  if [ -n "$known_hosts" ]; then cp "$known_hosts" "$dir/known_hosts"; fi
  # The agent a runtime grant reaches. Only the socket's presence matters
  # inside the sandbox; every process probe reaches it through the relay.
  if [ -n "$offered_agent" ]; then
    if [ "$agent_phase" = install ]; then
      # The install hook runs with the agent granted and records what it
      # offered, through the workload probe and the relay.
      if [ "$broken" = "ssh-agent-install-missing" ]; then
        echo "Could not open a connection to your authentication agent." >"$dir/ssh-agent-at-install"
      else
        run_ssh_probe "$dir" "$offered_agent" "$broken" list >"$dir/ssh-agent-at-install" 2>&1 || true
      fi
      printf '%s' /run/kit-tck/install-agent.sock >"$dir/install-ssh-sock"
      printf '%s' "$offered_agent" >"$dir/install-agent"
      if [ "$broken" = "leaves-install-ssh-agent-open" ]; then printf '%s' "$offered_agent" >"$dir/ssh-agent"; fi
      if [ "$broken" = "leaks-install-ssh-agent-to-entrypoint" ]; then
        printf '%s' /run/kit-tck/ssh-agent.sock >"$dir/workload-ssh-sock"
      fi
    elif [ "$agent_phase" = runtime ] && [ "$broken" != "ignores-ssh-agent" ]; then
      printf '%s' "$offered_agent" >"$dir/ssh-agent"
    elif [ -z "$agent_phase" ] && [ "$broken" = "ssh-agent-without-grant" ]; then
      printf '%s' "$offered_agent" >"$dir/ssh-agent"
    fi
  fi
  if [ -f "$dir/ssh-agent" ]; then
    record_ssh_processes "$dir" create
  fi
  if [ "$broken" = ssh-agent-initial-without-grant ] && [ -z "$agent_phase" ] && [ -n "$offered_agent" ]; then
    printf '%s' "$offered_agent" >"$dir/ssh-agent"
    record_ssh_processes "$dir" create
    rm "$dir/ssh-agent"
  fi
  if [ "$broken" = ssh-agent-initial-optional-leak ] && [ "$agent_phase" = runtime ] && [ -z "$offered_agent" ]; then
    printf '%s' /run/leaked-agent.sock >"$dir/workload-ssh-sock"
  fi
  if [ ! -f "$dir/workload-ssh-sock-proof" ]; then
    echo 'no agent' >"$dir/workload-ssh-sock-proof"
  fi
  # The entrypoint records an empty value when no runtime-phase grant
  # exists; only the leak mutation writes a non-empty value instead.
  if [ ! -f "$dir/workload-ssh-sock" ]; then : >"$dir/workload-ssh-sock"; fi
  for kit in "${kits[@]}"; do
    if [[ "$kit" == */groups ]]; then write_group_state "$dir" "$group_rejected"; fi
    if [[ "$kit" == */groups-republished ]]; then write_republished_state "$dir" "$group_rejected"; fi
    if [[ "$kit" == */groups-partial ]]; then
      rejected_member='capabilities[0].group.capabilities[1]'
      if [[ ",$claims," != *",com.docker.sandbox/volume@1,"* ]]; then
        rejected_member='capabilities[0].group.capabilities[0]'
      fi
      partial_surface='{}'
      if [ "$broken" = partial-group-applies-volume ]; then
        partial_surface='{"storagePaths":["/var/tmp/group-volume"]}'
      fi
      if [ "$broken" = partial-group-applies-lifecycle ]; then echo selected >"$dir/group-feature"; fi
      printf '{"selection":{"selected":[],"skipped":[{"path":"capabilities[0]","source":{"kit":"groups-partial","path":"capabilities[0]"},"members":["capabilities[0].group.capabilities[0]","capabilities[0].group.capabilities[1]"],"rejected":["%s"]}]},"surface":%s}\n' "$rejected_member" "$partial_surface" >"$dir/selection.json"
    fi
    if [[ "$kit" == */groups-partial ]] && [ "$lifecycle_rejected" = yes ] && [ "$broken" = group-ignore-optional-lifecycle ]; then
      echo '{"selection":{"selected":[],"skipped":[]},"surface":{"storagePaths":["/var/tmp/group-volume"]}}' >"$dir/selection.json"
      echo selected >"$dir/group-feature"
    fi
    if [[ "$kit" == */ordinary-optional ]]; then
      ordinary_record='{"path":"capabilities[0]","source":{"kit":"ordinary-optional","path":"capabilities[0]"},"members":["capabilities[0]"]}'
      if [ "$lifecycle_rejected" = yes ] && [ "$broken" != ordinary-ignore-optional-rejection ]; then
        printf '{"selection":{"selected":[],"skipped":[%s,"rejected":["capabilities[0]"]}]},"surface":{}}\n' "${ordinary_record%?}" >"$dir/selection.json"
      else
        echo selected >"$dir/ordinary-feature"
        printf '{"selection":{"selected":[%s],"skipped":[]},"surface":{}}\n' "$ordinary_record" >"$dir/selection.json"
      fi
    fi
  done
  for kit in "${kits[@]}"; do
    if [[ "$kit" == */long-running ]]; then : >"$dir/long-running-mixin"; fi
  done
  printf '%s' "1" >"$dir/install.count"
  printf '%s' "1" >"$dir/startup.count"
  # The install phase could reach its install-only domain; the boundary
  # closes afterwards.
  printf '%s' "reachable" >"$dir/install-egress"
  printf '%s' "closed" >"$dir/phase"
  # Before the hook environment is written, because that is where the
  # composed identity is first observed.
  for kit in "${kits[@]}"; do
    if [[ "$kit" == *sbx-workload* ]]; then : >"$dir/sbx"; fi
  done
  # A hook sees its declared env and the platform baseline, nothing else.
  {
    echo "PATH=/usr/bin"
    if [ -f "$dir/sbx" ] && [ "$broken" != "assumes-uid-1000" ]; then
      echo "HOME=/home/sbxagent"
    else
      echo "HOME=/home/agent"
    fi
    # A sentinel smuggled into a variable the hook legitimately sees: no
    # name is added, so only the stable-value comparison against the
    # credential-free hook baselines sees it.
    if [ "$broken" = "hides-install-inject-only-in-declared" ] && ( for kit in "${kits[@]}"; do [[ "$kit" == *credential-inject-only-install* ]] && exit 0; done; exit 1 ); then
      echo "DECLARED=inject-only-sentinel"
    else
      echo "DECLARED=yes"
    fi
    # A leaking runtime passes its own environment through, sentinel and all.
    if [ "$broken" = "leaks-env" ]; then echo "KIT_TCK_HOST_SENTINEL=${KIT_TCK_HOST_SENTINEL:-}"; fi
    # A leak that is not the sentinel: only exact-name judgment sees it.
    if [ "$broken" = "leaks-undeclared-env" ]; then echo "UNDECLARED=value"; fi
    # A host baseline value under an allowed name: the adapter's own PATH
    # carries the suite's sentinel component, so copying it is visible.
    if [ "$broken" = "copies-host-baseline" ]; then echo "PATH=$PATH"; fi
    if [ "$broken" = "copies-host-hostname" ]; then echo "HOSTNAME=${HOSTNAME:-}"; fi
    if [ "$broken" = "copies-host-home" ]; then echo "HOME=${HOME:-}"; fi
    if [ "$broken" = "copies-host-pwd" ]; then echo "PWD=$(pwd)"; fi
    # A runtime inventing an env slot for an install-phase inject-only
    # credential: it surfaces only in install hooks, which is exactly
    # where the phase-blind no-env duty is judged.
    if [ "$broken" = "exposes-install-inject-only" ]; then
      for kit in "${kits[@]}"; do
        if [[ "$kit" == *credential-inject-only-install* ]]; then echo "KIT_TCK_INSTALL_TOKEN=sentinel-token"; fi
      done
    fi
  } >"$dir/hook.env"
  # Only a composed kit whose hook records its environment produces the
  # file, as on a real runtime: a check reading it from any other
  # composition must fail here too, not only against real runtimes.
  records_env=
  for kit in "${kits[@]}"; do
    if [[ "$kit" == *restricted-env* || "$kit" == *credential-inject-only-install* ]]; then records_env=1; fi
  done
  if [ -z "$records_env" ]; then rm -f "$dir/hook.env"; fi
  if [ "$broken" = "ignores-files" ]; then printf '%s' "" >"$dir/kit-written"; else printf '%s' "$greeting" >"$dir/kit-written"; fi
  mkdir -p "$dir/volume"
  if [ "$hostmode" = "readonly" ]; then : >"$dir/host-skills-readonly"; fi
  # A co-composed kit widening the shared path to readwrite.
  for kit in "${kits[@]}"; do
    if [[ "$kit" == *skills-shared* ]]; then : >"$dir/skills-shared"; fi
    if [[ "$kit" == *credential-inject-only* ]]; then : >"$dir/inject-only"; fi
    if [[ "$kit" == *credential-inject-only-plain* ]]; then : >"$dir/inject-only-plain"; fi
    if [[ "$kit" == *credential-inject-only-install* ]]; then : >"$dir/inject-only-install"; fi
  done
  # The host's shared store is one directory at state level, seeded once
  # with the contract's marker. Every declared path is a view of it — a
  # per-sandbox copy would satisfy every listing while violating "every
  # declared path receives the same store", which is exactly what the
  # cross-path write check exists to catch.
  store="$state/store"
  mkdir -p "$store"
  if [ "$broken" != "empty-skills" ] && [ "$broken" != "wrong-skill" ]; then
    : >"$store/${KIT_TCK_SKILL_NAME:-unset}"
  fi
  # A neighbour of the marker, to catch a substring match.
  if [ "$broken" = "wrong-skill" ]; then : >"$store/${KIT_TCK_SKILL_NAME:-unset}-old"; fi

  # A skipped optional entry gets no mount; only a broken runtime mounts
  # something at its path anyway.
  if [ -n "$optional_skills" ]; then
    if [ "$hostmode" != "off" ] || [ "$broken" = "mounts-optional-despite-off" ]; then
      ln -s "$store" "$dir/skills-opt"
    fi
  fi
  # The shared store, mounted where the kit asked for it.
  if [ "$broken" != "ignores-skills" ] && [ "$hostmode" != "off" ]; then
    ln -s "$store" "$dir/skills"
    case "$broken" in
    first-skills-only)
      # A runtime that honours the first declaration and stops.
      ;;
    writable-decoy)
      # A writable scratch directory in place of the shared store: the
      # write succeeds and proves nothing, and the marker is missing.
      mkdir -p "$dir/skills-rw"
      ;;
    separate-stores)
      # An independent copy per path: every listing looks right, but a
      # write through one path never reaches the others.
      mkdir -p "$dir/skills-rw"
      : >"$dir/skills-rw/${KIT_TCK_SKILL_NAME:-unset}"
      ;;
    *)
      ln -s "$store" "$dir/skills-rw"
      ;;
    esac
  fi
  # What each skills fixture's install hook saw: hooks run at create, so
  # a runtime that mounts a store afterwards records the miss here.
  # mounts-later-skills-late is the sneak: the first declaration on time,
  # later ones after hooks.
  if [ "$broken" = "mounts-skills-late" ] || [ ! -d "$dir/skills" ]; then
    echo "ls: cannot access '/home/agent/.kit-tck/skills': No such file or directory" >"$dir/skills-at-install"
  else
    ls "$dir/skills" >"$dir/skills-at-install"
  fi
  if [ "$broken" = "mounts-skills-late" ] || [ "$broken" = "mounts-later-skills-late" ] || [ ! -d "$dir/skills-rw" ]; then
    echo "ls: cannot access '/home/agent/.kit-tck/skills-rw': No such file or directory" >"$dir/skills-rw-at-install"
  else
    ls "$dir/skills-rw" >"$dir/skills-rw-at-install"
  fi
  if [ "$broken" != "no-context" ]; then
    # Surfaced progressively: the profile points at the kit's staged body
    # rather than restating it, which is the reference the check asserts.
    printf '%s\n' "## context" "See /usr/share/sandbox/kit/context/context.md" >"$dir/profile"
  else
    # A runtime ignoring agent-context writes the workload's own profile
    # and surfaces nothing into it.
    printf '%s\n' "Conformance workload." >"$dir/profile"
  fi
  echo "$id"
  ;;

exec)
  id="$1"
  shift
  [ "${1:-}" = "--" ] && shift
  dir="$state/$id"
  case "${1:-}" in
  kit-tck-background)
    if [ "$2" = start ]; then echo original >"$dir/background"; fi
    if [ ! -f "$dir/background" ]; then echo "background process is gone" >&2; exit 1; fi
    cat "$dir/background"
    ;;
  cat)
    case "$2" in
    /var/tmp/group-order) cat "$dir/group-order" ;;
    /var/tmp/group-feature) cat "$dir/group-feature" ;;
    /var/tmp/ordinary-feature) cat "$dir/ordinary-feature" ;;
    /var/tmp/install.count) cat "$dir/install.count" ;;
    /var/tmp/startup.count) cat "$dir/startup.count" ;;
    /var/tmp/sbx-entrypoint-ran)
      if [ "$broken" = "runs-image-entrypoint" ] && [ -f "$dir/sbx" ]; then
        echo ran
      else
        echo "no such file: $2" >&2
        exit 1
      fi
      ;;
    /var/tmp/install-egress) cat "$dir/install-egress" ;;
    /var/tmp/hook.env) cat "$dir/hook.env" ;;
    /var/tmp/kit-tck-workload-ssh-sock) cat "$dir/workload-ssh-sock" ;;
    /var/tmp/kit-tck-startup-ssh-sock) cat "$dir/startup-ssh-sock" ;;
    /var/tmp/kit-tck-workload-ssh-sock-proof) cat "$dir/workload-ssh-sock-proof" ;;
    /var/tmp/kit-tck-startup-ssh-sock-proof) cat "$dir/startup-ssh-sock-proof" ;;
    /var/tmp/ssh-agent-install-sock) cat "$dir/install-ssh-sock" ;;
    /var/tmp/ssh-agent-at-install)
      if [ -f "$dir/ssh-agent-at-install" ]; then cat "$dir/ssh-agent-at-install"; else
        echo "no such file: $2" >&2
        exit 1
      fi
      ;;
    /var/tmp/skills-at-install) cat "$dir/skills-at-install" ;;
    /var/tmp/skills-rw-at-install) cat "$dir/skills-rw-at-install" ;;
    /home/agent/.config/kit-written) cat "$dir/kit-written" ;;
    /home/agent/AGENTS.md) cat "$dir/profile" ;;
    /home/sbxagent/AGENTS.md)
      if [ -f "$dir/sbx" ] && [ "$broken" != "workspace-at-fixed-path" ]; then
        cat "$dir/profile"
      else
        echo "no such file: $2" >&2
        exit 1
      fi
      ;;
    /usr/share/sandbox/kit/context/context.md)
      # The staged body behind the profile's reference. A runtime that
      # surfaces the reference while dropping the mixin's layers has an
      # index into nothing.
      if [ "$broken" = "drops-context-body" ]; then
        echo "no such file: $2" >&2
        exit 1
      fi
      echo "Conformance fixture context body."
      ;;
    /var/tmp/kit-tck-scratch)
      if [ -f "$dir/scratch" ]; then cat "$dir/scratch"; else
        echo "no such file" >&2
        exit 1
      fi
      ;;
    /data/marker)
      if [ -f "$dir/volume/marker" ]; then cat "$dir/volume/marker"; else
        echo "no such file" >&2
        exit 1
      fi
      ;;
    *)
      echo "no such file: $2" >&2
      exit 1
      ;;
    esac
    ;;
  stat)
    # Who a declared file belongs to. A runtime leaving one root-owned
    # puts it off the plane this capability stays on, and its content
    # reads the same either way.
    case "$2 $3" in
    "-c %u") ;;
    *) echo "unsupported stat request: $2 $3" >&2; exit 1 ;;
    esac
    if [ "$broken" = "writes-files-as-root" ]; then echo 0; else echo 1000; fi
    ;;

  test)
    # Whether the agent can change what was declared for it. Owning a
    # file it cannot write leaves the entry as unusable as one it does
    # not own.
    case "$2" in
    -w) ;;
    *) echo "unsupported test: $2" >&2; exit 1 ;;
    esac
    [ "$broken" != "writes-files-read-only" ]
    ;;

  id)
    # The identity comes from the image the sandbox was created from; the
    # fixture's is deliberately not the conventional uid 1000 / agent.
    if [ -f "$dir/sbx" ] && [ "$broken" != "assumes-uid-1000" ]; then
      case "$2" in
      -u | -g) echo 1234 ;;
      -un) echo sbxagent ;;
      *) echo "unsupported id flag: $2" >&2; exit 1 ;;
      esac
    else
      case "$2" in
      -u | -g) echo 1000 ;;
      -un) echo agent ;;
      *) echo "unsupported id flag: $2" >&2; exit 1 ;;
      esac
    fi
    ;;

  env)
    echo "PATH=/usr/bin"
    echo "HOME=/home/agent"
    if [ "$broken" = "hides-inject-only-in-token" ] && [ -f "$dir/inject-only" ]; then
      echo "KIT_TCK_TOKEN=inject-only-sentinel"
    else
      echo "KIT_TCK_TOKEN=sentinel-token"
    fi
    # A sentinel smuggled into a variable the workload already owns: no
    # name is added, so only the value comparison on the image-owned
    # canary sees it.
    if [ "$broken" = "hides-inject-only-in-existing-env" ] && [ -f "$dir/inject-only" ]; then
      echo "KIT_TCK_CANARY=inject-only-sentinel"
    else
      echo "KIT_TCK_CANARY=image-baseline"
    fi
    # The secret smuggled under an unrelated name: only a whole-environment
    # scan sees it.
    if [ "$broken" = "leaks-secret-elsewhere" ]; then echo "UNRELATED_DEBUG=${KIT_TCK_BOUND_SECRET:-}"; fi
    # A runtime inventing an env slot for an inject-only credential: the
    # variable appears only in sandboxes that composed that kit, so a
    # baseline diff sees it.
    if [ "$broken" = "leaks-inject-only-env" ] && [ -f "$dir/inject-only" ]; then echo "KIT_TCK_INJECT_TOKEN=sentinel-token"; fi
    # Leaks only for the default-management fixture: proves the check
    # judges that composition too, not just the proxyManaged one.
    if [ "$broken" = "leaks-plain-inject-only-env" ] && [ -f "$dir/inject-only-plain" ]; then echo "KIT_TCK_PLAIN_TOKEN=sentinel-token"; fi
    ;;

  printenv)
    if [ "$2" = HOME ]; then
      if [ -f "$dir/sbx" ] && [ "$broken" != "assumes-uid-1000" ]; then
        echo /home/sbxagent
      else
        echo /home/agent
      fi
      exit 0
    fi
    # The container sees a sentinel; the real secret never arrives.
    if [ "$broken" = "no-credential" ]; then
      echo "printenv: KIT_TCK_TOKEN: not set" >&2
      exit 1
    fi
    if [ "$broken" = "leaks-secret" ]; then echo "${KIT_TCK_BOUND_SECRET:-}"; fi
    # A decorated leak: the secret embedded in a larger value, which an
    # equality check would wave through.
    if [ "$broken" = "leaks-secret-decorated" ]; then echo "Bearer ${KIT_TCK_BOUND_SECRET:-}"; fi
    if [ "$broken" != "leaks-secret" ] && [ "$broken" != "leaks-secret-decorated" ]; then echo "sentinel-token"; fi
    ;;
  kit-tck-probe)
    case "$2" in
    https://example.com) exit 0 ;;
    https://example.net)
      # Reachable only while the install phase is open. Exit 7 is the
      # probe's policy-denial status; a transport failure would be
      # anything else and must not pass a deny assertion.
      if [ "$(cat "$dir/phase")" = "open" ] || [ "$broken" = "leaves-install-egress-open" ]; then exit 0; fi
      echo "refused by policy" >&2
      exit 7
      ;;
    *)
      if [ "$broken" = "allows-everything" ]; then exit 0; fi
      echo "refused by policy" >&2
      exit 7
      ;;
    esac
    ;;
  kit-tck-http-probe)
    # $2 is the method, $3 the URL. The host is reachable; only the HTTP
    # rules decide, so each broken mode drops exactly one of them.
    case "$3" in
    https://example.org/*)
      # The refused-method control target: POST is allowed here.
      if [ "$2" = "POST" ]; then exit 0; fi
      echo "refused by policy: method $2" >&2
      exit 7
      ;;
    https://example.com/allowed/secret/*)
      # Before the allow arm, which matches this path too: only deny
      # precedence refuses it, so that is the one thing being dropped.
      if [ "$broken" = "ignores-http-deny" ]; then exit 0; fi
      echo "refused by policy: deny rule" >&2
      exit 7
      ;;
    https://example.com/allowed/*)
      if [ "$2" = "GET" ] || [ "$broken" = "ignores-http-method" ]; then exit 0; fi
      echo "refused by policy: method $2" >&2
      exit 7
      ;;
    https://example.com/*)
      if [ "$broken" = "ignores-http-path" ]; then exit 0; fi
      echo "refused by policy: path" >&2
      exit 7
      ;;
    *)
      echo "refused by policy" >&2
      exit 7
      ;;
    esac
    ;;
  ls)
    case "$2" in
    /home/agent/.kit-tck/skills-opt)
      if [ -d "$dir/skills-opt" ]; then ls "$dir/skills-opt"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    /home/agent/.kit-tck/skills-rw)
      if [ -d "$dir/skills-rw" ]; then ls "$dir/skills-rw"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    /home/agent/.kit-tck/skills)
      if [ -d "$dir/skills" ]; then ls "$dir/skills"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    *)
      echo "unsupported path: $2" >&2
      exit 1
      ;;
    esac
    ;;
  kit-tck-write)
    case "$2" in
    /var/tmp/kit-tck-scratch)
      printf '%s' "$3" >"$dir/scratch"
      ;;
    /home/agent/.kit-tck/skills/*)
      # A co-composed readwrite declaration widens this mount, unless the
      # runtime wrongly resolves the shared path to the narrower mode.
      if [ -f "$dir/skills-shared" ] && [ "$broken" != "narrows-shared-path" ] && [ ! -f "$dir/host-skills-readonly" ]; then
        : >"$dir/skills/$(basename "$2")"
        exit 0
      fi
      # Alone, the kit declared no mode, so this mount is read-only
      # however permissive the host is.
      if [ "$broken" = "ignores-readonly" ]; then
        : >"$dir/skills/$(basename "$2")"
        exit 0
      fi
      echo "read-only file system" >&2
      exit 1
      ;;
    /home/agent/.kit-tck/skills-rw/*)
      # The host withholds write however much the kit asked for.
      if [ -f "$dir/host-skills-readonly" ] && [ "$broken" != "ignores-host-readonly" ]; then
        echo "read-only file system" >&2
        exit 1
      fi
      if [ "$broken" = "ignores-readwrite" ]; then
        echo "read-only file system" >&2
        exit 1
      fi
      : >"$dir/skills-rw/$(basename "$2")"
      ;;
    *)
      mkdir -p "$(dirname "$dir/volume/$(basename "$2")")"
      printf '%s' "$3" >"$dir/volume/$(basename "$2")"
      ;;
    esac
    ;;
  kit-tck-memory-limit)
    if [ "$broken" = "ignores-resources" ]; then echo "max"; else echo "2147483648"; fi
    ;;
  kit-tck-ssh-agent)
    # The workload's probe, run against the fake's relay: a socket served
    # for this one call by the relay, which enforces the sandbox's entry
    # in front of the backing agent. What reaches the backing agent is
    # what the suite judges, as it would for a real runtime.
    if [ "$2" = saved ]; then
      if [ "$broken" = install-socket-still-reachable ] && [ -f "$dir/install-agent" ]; then
        run_ssh_probe "$dir" "$(cat "$dir/install-agent")" "$broken" list
        exit $?
      fi
      exit 2
    fi
    if [ "$2" = socket ]; then
      if [ -f "$dir/ssh-agent" ]; then echo /run/kit-tck/ssh-agent.sock; else echo; fi
      exit 0
    fi
    if [ ! -f "$dir/ssh-agent" ]; then
      echo "Could not open a connection to your authentication agent." >&2
      exit 2
    fi
    shift
    run_ssh_probe "$dir" "$(cat "$dir/ssh-agent")" "$broken" "$@"
    ;;
  kit-tck-privileged)
    if [ "$broken" = "ignores-privileged" ]; then echo "no"; else echo "yes"; fi
    ;;
  *)
    echo "unsupported command: $*" >&2
    exit 1
    ;;
  esac
  ;;

wait-idle)
  dir="$state/$1"
  case "$broken" in
  stops-on-disconnect) echo stopped >"$dir/status" ;;
  ignores-long-running-mixin)
    if [ -f "$dir/long-running-mixin" ]; then echo stopped >"$dir/status"; fi
    ;;
  loses-background-on-disconnect) rm -f "$dir/background" ;;
  restarts-background-on-disconnect) echo replacement >"$dir/background" ;;
  idle-errors) echo "idle observation failed" >&2; exit 1 ;;
  esac
  ;;

status)
  if [ "$broken" = "status-errors" ]; then exit 1; fi
  if [ "$broken" = "status-malformed" ]; then echo unknown; exit 0; fi
  cat "$state/$1/status"
  ;;

stop)
  if [ "$broken" != "ignores-explicit-stop" ]; then echo stopped >"$state/$1/status"; fi
  ;;

selection)
  cat "$state/$1/selection.json"
  ;;

selection-policy)
  rejection=no
  if [ "$#" -gt 1 ]; then rejection=yes; fi
  echo "$rejection" >"$state/$1/group-future-rejected"
  ;;

recreate)
  if [ -f "$state/$1/group-rejected" ] && [ "$broken" != group-no-recreate ]; then
    cp "$state/$1/selection.json" "$state/$1/previous-selection.json"
    cp "$state/$1/group-order" "$state/$1/previous-group-order"
    rejection="$(cat "$state/$1/group-future-rejected")"
    if [ "$broken" = group-never-admits-recreate ] && [ "$(cat "$state/$1/group-rejected")" = yes ]; then rejection=yes; fi
    write_group_state "$state/$1" "$rejection"
    if [ "$broken" = group-stale-recreate-records ]; then
      sed 's/"storagePaths":\["[^"]*"\]/"storagePaths":[]/' "$state/$1/previous-selection.json" >"$state/$1/selection.json"
    fi
    if [ "$broken" = group-stale-recreate-hooks ]; then
      cp "$state/$1/previous-group-order" "$state/$1/group-order"
    fi
  fi
  # A fresh container: the writable layer goes, declared volumes stay.
  dir="$state/$1"
  if [ "$broken" != "keeps-writable-layer" ]; then rm -f "$dir/scratch"; fi
  if [ "$broken" = "loses-volume" ]; then rm -rf "$dir/volume" && mkdir -p "$dir/volume"; fi
  ;;

start)
  dir="$state/$1"
  if [ -f "$dir/group-rejected" ]; then
    rejection="$(cat "$dir/group-rejected")"
    if [ "$broken" = group-reselect-restart ]; then rejection="$(cat "$dir/group-future-rejected")"; fi
    if [ "$broken" = group-reselect-skipped-restart ] && [ "$rejection" = yes ]; then rejection="$(cat "$dir/group-future-rejected")"; fi
    write_group_state "$dir" "$rejection"
  fi
  echo running >"$dir/status"
  if [ "$broken" = "ssh-agent-first-boot-only" ]; then rm -f "$dir/ssh-agent"; fi
  if [ -f "$dir/ssh-agent" ] && [ "$broken" != ssh-agent-stale-boot-proofs ]; then record_ssh_processes "$dir" restart; fi
  if [ "$broken" = "loses-volume-on-restart" ]; then rm -rf "$dir/volume" && mkdir -p "$dir/volume"; fi
  if [ "$broken" != "no-startup" ]; then
    count=$(cat "$dir/startup.count")
    printf '%s' "$((count + 1))" >"$dir/startup.count"
  fi
  if [ "$broken" = "install-twice" ]; then
    count=$(cat "$dir/install.count")
    printf '%s' "$((count + 1))" >"$dir/install.count"
  fi
  ;;

rm)
  rm -rf "${state:?}/$1"
  ;;

*)
  echo "unknown verb: $verb" >&2
  exit 2
  ;;
esac
